def call() {

    // This is all of the repos in the enviroment that are being pulled
    // can move this to a config file 
    // this is a list of maps

    def repos = [  
        [name: "repo1",         url: "https://versionctl.company.com/scm/<project>/<repo>.git"],
        [name: "build-artifact",url: "https://versionctl.company.com/scm/<project>/<repo>.git"],
        [name: "repo2",         url: "https://versionctl.company.com/scm/<project>/<repo>.git"],
        [name: "repo3",         url: "https://versionctl.company.com/scm/<project>/<repo>.git"],
        [name: "repo4",         url: "https://versionctl.company.com/scm/<project>/<repo>.git"],
        [name: "repo5",         url: "https://versionctl.company.com/scm/<project>/<repo>.git"],
     
    ]
    echo "Starting multi-repo checkout from Nexus"

   // Loop through each repository entry in the 'repos' list.
   // Each entry contains: [name: "<folder>", url: "<git-url>"]
   repos.each { repo ->

    // Print which repository is being checked out.
    // pipeline logs.
    echo "Checking out ${repo.name}"

    // Create (or switch into) a directory named after the repo.
    // This ensures each repo is checked out into its own folder:
    //   workspace/repo1/
    //   workspace/repo2/
    //   workspace/repo3/
    //   etc.
    dir(repo.name) {

        // pipeline' built-in Git checkout step.
        // This is more powerful than 'git clone' because it supports:
        // - credentials
        // - branch selection
        // - shallow clones
        // - retries
        // - pipeline SCM polling
        checkout([
            $class: 'GitSCM',                 // Tells Jenkins to use the Git plugin
            branches: [[name: "Whatever final branch is in powerpoint"]],  //  branch to check out 
            
            // Remote repository configuration
            userRemoteConfigs: [[
                url: repo.url,         // Bitbucket URL 
                credentialsId: "nex-git-creds"  
                // pipeline credID used to authenticate to versionctl of choice.
                // Replace with versionctl credID.
            ]]
        ])
    }

    // After all repos have been processed, print a confirmation message.
    echo "All repositories successfully checked out"
   }
