def call() {

    // This is all of the repos in the enviroment that are being pulled
    // can move this to a config file 
    // this is a list of maps
    def repos = [  
        [name: "repo1",         url: "https://bitbucket.company.com/scm/<project>/<repo>.git"],
        [name: "build-artifact",    url: "https://bitbucket.company.com/scm/<project>/<repo>.git"],
        [name: "repo2",         url: "https://bitbucket.company.com/scm/<project>/<repo>.git"],
        [name: "repo3",         url: "https://bitbucket.company.com/scm/<project>/<repo>.git"],
        [name: "repo4",         url: "https://bitbucket.company.com/scm/<project>/<repo>.git"],
        [name: "repo5",         url: "https://bitbucket.company.com/scm/<project>/<repo>.git"],
        [name: "repo6",         url: "https://bitbucket.company.com/scm/<project>/<repo>.git"],
        [name: "repo7",         url: "https://bitbucket.company.com/scm/<project>/<repo>.git"],
        [name: "repo8",         url: "https://bitbucket.company.com/scm/<project>/<repo>.git"]
        [name: "repo9",         url: "https://bitbucket.company.com/scm/<project>/<repo>.git"],
        [name: "repo10",        url: "https://bitbucket.company.com/scm/<project>/<repo>.git"],
        [name: "repo11",        url: "https://bitbucket.company.com/scm/<project>/<repo>.git"]
    ]

    echo "Starting multi-repo checkout from Nexus"

   // Loop through each repository entry in the 'repos' list.
   // Each entry contains: [name: "<folder>", url: "<git-url>"]
   repos.each { repo ->

    // Print which repository is being checked out.
    // pipeline logs.
    echo "Checking out ${repo.name}"

    // Create (or switch into) a directory named after the repo.
    // This ensures each repo is checked out into its own folder:
    //   workspace/repo1/
    //   workspace/repo2/
    //   workspace/repo3/
    //   etc.
    dir(repo.name) {

        // Jenkins' built-in Git checkout step.
        // This is more powerful than 'git clone' because it supports:
        // - credentials
        // - branch selection
        // - shallow clones
        // - retries
        // - Jenkins SCM polling
        checkout([
            $class: 'GitSCM',                 // Tells Jenkins to use the Git plugin
            branches: [[name: "*/master"]],  //  branch to check out (master)
            
            // Remote repository configuration
            userRemoteConfigs: [[
                url: repo.url,         // Bitbucket URL 
                credentialsId: "nexus-git-creds"  
                // Jenk credID used to authenticate to Bitbucket.
                // Replace with Bitbucket credID.
            ]]
        ])
    }
}

// After all repos have been processed, print a confirmation message.
echo "All repositories successfully checked out"


